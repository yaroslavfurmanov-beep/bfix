---
import { asset } from '../lib/asset';
import Button from './Button.astro';
import eye from '../icons/eye.svg?raw';
import phone from '../icons/phone.svg?raw';
---
<section class="hero" id="top">
  <img class="hero__bg" src={asset("/img/hero.webp")} alt="" width="1402" height="837" fetchpriority="high" data-hero-bg />
  <div class="hero__content" data-fit="hero">
    <div class="hero__spacer" aria-hidden="true"></div>
    <div class="hero__group">
      <h1 class="hero__title t-display" data-split>Handyman<br />Services in florida</h1>
      <p class="hero__sub t-h2" data-hero-item>you can trust</p>
      <p class="hero__stats t-h3" data-hero-item>3 years / 110+ jobs</p>
    </div>
    <div class="hero__actions" data-hero-item>
      <Button href="#works" variant="orange" class="btn--white"><Fragment set:html={eye} />Portfolio</Button>
      <div class="hero__call">
        <Button href="tel:+15619386333" variant="outline-light" width={187}><Fragment set:html={phone} />Take a call</Button>
        <p class="hero__note"><b>10% off</b> your first job</p>
      </div>
    </div>
    <div class="hero__spacer" aria-hidden="true"></div>
    <div class="hero__lift" aria-hidden="true"></div>
  </div>
</section>

<style>
  /* first screen: always fits the viewport together with the header and promo bar */
  .hero {
    position: relative;
    width: 100%;
    min-width: var(--page);
    height: calc(100svh - var(--header-h) - 32px);
    min-height: 420px;
    overflow: hidden;
    color: var(--n-100);
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
  }
  .hero__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* text + buttons are centred as one block and lifted up to 90px (see .hero__lift) */
    padding: 24px 0 40px;
    text-align: center;
    color: var(--white);
  }
  .hero__group { display: flex; flex-direction: column; align-items: center; }
  .hero__spacer { flex: 1 1 0; min-height: 24px; }
  /* takes a share of the free space below the block (max 180px), which lifts the block by up to 90px */
  .hero__lift { flex: 1 1 0; max-height: 180px; }
  .hero__title { width: 920px; color: var(--white); }
  .hero__sub { color: var(--white); }
  .hero__stats { margin-top: 8px; color: var(--white); }
  .hero__actions {
    display: flex;
    gap: 15px;
    margin-top: 48px;
  }
  .hero__call { position: relative; display: flex; justify-content: center; }
  .hero__note {
    position: absolute;
    top: 64px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 14px;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--white);
  }
  .hero__note b { font-weight: 700; }
  .hero :global(.btn--white) { color: var(--white); }

  /* ---------- phones ---------- */
  @media (max-width: 767px) {
    .hero { min-width: 0; height: auto; min-height: calc(100svh - var(--header-h) - 32px); }
    .hero__bg { object-position: 62% 50%; }
    /* darker at the text so white type stays readable on the bright part of the photo */
    .hero::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(14, 14, 14, .15) 0%, rgba(14, 14, 14, .35) 45%, rgba(14, 14, 14, .45) 100%);
      pointer-events: none;
    }
    .hero__content { z-index: 1; padding: 32px var(--gutter) 40px; }
    .hero__title { width: auto; max-width: 11ch; }
    .hero__sub { margin-top: 10px; }
    .hero__stats { margin-top: 10px; font-size: 18px; }
    .hero__lift { max-height: 72px; }
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
      width: 100%;
      max-width: 400px;
      margin-top: 32px;
    }
    .hero__actions :global(.btn) { width: 100%; }
    .hero__call { flex-direction: column; align-items: center; gap: 8px; }
    .hero__note { position: static; transform: none; font-size: 13px; }
  }
</style>
