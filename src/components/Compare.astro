---
import Bricks from './Bricks.astro';
import { compareLeft, compareRight } from '../data/bricks';
import { compareSlides } from '../data/content';
const total = String(compareSlides.length).padStart(2, '0');
---
<section class="compare screen" id="difference">
  <div class="wrap compare__inner" data-fit>
    <Bricks bricks={compareLeft} origin={[0, 1736]} />
    <Bricks bricks={compareRight} origin={[0, 1736]} />

    <h2 class="t-h3 compare__title" data-reveal>See the difference</h2>
    <p class="t-body compare__sub" data-reveal>Real jobs from around Florida.<br />Drag the slider to see each one before and after.</p>

    <div class="ba" data-ba data-reveal style="--pos:50%">
      {compareSlides.map((s, i) => (
        <div class={`ba__slide${i === 0 ? ' is-active' : ''}`} data-ba-slide aria-hidden={i === 0 ? 'false' : 'true'}>
          <img class="ba__img" src={s.before} alt={`${s.title} — before`} width="794" height="393" loading={i === 0 ? 'eager' : 'lazy'} draggable="false" />
          <div class="ba__after">
            <img class="ba__img" src={s.after} alt={`${s.title} — after`} width="794" height="393" loading={i === 0 ? 'eager' : 'lazy'} draggable="false" />
          </div>
        </div>
      ))}
      <span class="ba__tag ba__tag--l t-label">After</span>
      <span class="ba__tag ba__tag--r t-label">Before</span>
      <div
        class="ba__handle"
        role="slider"
        tabindex="0"
        aria-label="Before / after comparison"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="50"
        data-ba-handle
      >
        <span class="ba__knob" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20"><path d="M9 6 3 12l6 6M15 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2"/></svg>
        </span>
      </div>
    </div>

    <div class="pager" data-reveal>
      <button class="arrow arrow--outline" type="button" aria-label="Previous project" data-ba-prev>
        <svg viewBox="0 0 56 56" width="56" height="56" aria-hidden="true"><polygon class="arrow__shape" points="1,15.6 15.9,1 55,1 55,40.9 40.5,55 1,55" /><path d="M32 21l-7 7 7 7" class="arrow__icon" /></svg>
      </button>
      <p class="pager__count w6"><span data-ba-current>01</span> / {total}</p>
      <button class="arrow arrow--solid" type="button" aria-label="Next project" data-ba-next>
        <svg viewBox="0 0 56 56" width="56" height="56" aria-hidden="true"><polygon class="arrow__shape" points="0,15.22 15.64,0 56,0 56,41.32 40.92,56 0,56" /><path d="M24 21l7 7-7 7" class="arrow__icon" /></svg>
      </button>
    </div>
  </div>
</section>

<style>
  .compare__inner { display: flex; flex-direction: column; align-items: center; }
  .compare__title { text-align: center; }
  .compare__sub { width: 312px; margin-top: 8px; text-align: center; }

  .ba {
    position: relative;
    width: 794px;
    height: 393px;
    margin-top: 24px;
    overflow: hidden;
    background: var(--n-200);
    cursor: ew-resize;
    touch-action: pan-y;
    user-select: none;
  }
  .ba__slide { position: absolute; inset: 0; visibility: hidden; }
  .ba__slide.is-active { visibility: visible; }
  .ba__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .ba__after {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .ba__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 4px;
    margin-left: -2px;
    z-index: 3;
    background: var(--white);
    outline: none;
  }
  .ba__knob {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--white);
    background: var(--brand-orange);
    clip-path: polygon(0 10px, 10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%);
    transform: translate(-50%, -50%);
    transition: transform .3s var(--ease-out), background .2s;
  }
  .ba:hover .ba__knob,
  .ba__handle:focus-visible .ba__knob { transform: translate(-50%, -50%) scale(1.1); background: var(--brand-orange-light); }
  .ba.is-dragging .ba__knob { transform: translate(-50%, -50%) scale(.95); }
  .ba__tag {
    position: absolute;
    top: 16px;
    padding: 4px 10px;
    color: var(--white);
    z-index: 3;
    background: rgba(14, 14, 14, .55);
    pointer-events: none;
  }
  .ba__tag--l { left: 16px; }
  .ba__tag--r { right: 16px; }

  .pager {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 40px;
  }
  .pager__count {
    min-width: 50px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .arrow {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transition: transform .3s var(--ease-out);
  }
  .arrow svg { overflow: visible; }
  .arrow__icon { fill: none; stroke-width: 2; }
  .arrow--outline .arrow__shape { fill: transparent; stroke: var(--n-300); stroke-width: 2; transition: fill .2s, stroke .2s; }
  .arrow--outline .arrow__icon { stroke: var(--n-300); transition: stroke .2s; }
  .arrow--outline:hover .arrow__shape { stroke: var(--n-800); }
  .arrow--outline:hover .arrow__icon { stroke: var(--n-800); }
  .arrow--solid { filter: drop-shadow(0 4px 12px rgba(222, 82, 34, 0)); transition: transform .3s var(--ease-out), filter .3s; }
  .arrow--solid:hover { filter: drop-shadow(0 4px 12px rgba(222, 82, 34, .45)); }
  .arrow--solid .arrow__shape { fill: var(--brand-orange); transition: fill .2s; }
  .arrow--solid .arrow__icon { stroke: var(--white); }
  .arrow--solid:hover .arrow__shape { fill: var(--brand-orange-light); }
  .arrow:hover { transform: translateY(-2px); }
  .arrow:focus-visible { outline: 2px solid var(--n-800); outline-offset: 4px; }
  /* ---------- phones ---------- */
  @media (max-width: 767px) {
    .compare__sub { width: auto; max-width: 320px; }
    .ba {
      width: calc(100% + 2 * var(--gutter));
      height: auto;
      aspect-ratio: 4 / 3;
      margin: 24px calc(-1 * var(--gutter)) 0;
    }
    .ba__knob { width: 48px; height: 48px; }
    .ba__tag { top: 12px; font-size: 12px; }
    .ba__tag--l { left: 12px; }
    .ba__tag--r { right: 12px; }
    .pager { margin-top: 24px; }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const root = document.querySelector<HTMLElement>('[data-ba]');
  if (root) {
    const handle = root.querySelector<HTMLElement>('[data-ba-handle]')!;
    const slides = [...root.querySelectorAll<HTMLElement>('[data-ba-slide]')];
    const current = document.querySelector<HTMLElement>('[data-ba-current]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let pos = 50;
    let index = 0;
    let dragging = false;

    const set = (p: number) => {
      pos = Math.min(100, Math.max(0, p));
      root.style.setProperty('--pos', pos + '%');
      handle.setAttribute('aria-valuenow', String(Math.round(pos)));
    };
    let tween: gsap.core.Tween | null = null;
    const animateTo = (target: number, duration: number) => {
      tween?.kill();
      if (reduce) { set(target); return; }
      const o = { v: pos };
      tween = gsap.to(o, { v: target, duration, ease: 'power3.out', onUpdate: () => set(o.v) });
    };
    const fromEvent = (e: PointerEvent) => {
      const r = root.getBoundingClientRect();
      return ((e.clientX - r.left) / r.width) * 100;
    };

    root.addEventListener('pointerdown', (e) => {
      dragging = true;
      root.classList.add('is-dragging');
      root.setPointerCapture(e.pointerId);
      animateTo(fromEvent(e), .35);
    });
    root.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      tween?.kill();
      set(fromEvent(e));
    });
    const stop = () => { dragging = false; root.classList.remove('is-dragging'); };
    root.addEventListener('pointerup', stop);
    root.addEventListener('pointercancel', stop);

    handle.addEventListener('keydown', (e) => {
      const step = e.shiftKey ? 10 : 2;
      if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') { set(pos - step); e.preventDefault(); }
      if (e.key === 'ArrowRight' || e.key === 'ArrowUp') { set(pos + step); e.preventDefault(); }
      if (e.key === 'Home') { set(0); e.preventDefault(); }
      if (e.key === 'End') { set(100); e.preventDefault(); }
    });

    const go = (dir: number) => {
      const prev = slides[index];
      index = (index + dir + slides.length) % slides.length;
      const next = slides[index];
      current.textContent = String(index + 1).padStart(2, '0');
      slides.forEach((s) => s.setAttribute('aria-hidden', s === next ? 'false' : 'true'));
      next.classList.add('is-active');
      if (reduce) { prev.classList.remove('is-active'); set(50); return; }
      gsap.set(prev, { zIndex: 1 });
      gsap.set(next, { zIndex: 2 });
      gsap.fromTo(next, { opacity: 0, scale: 1.04 }, {
        opacity: 1, scale: 1, duration: .6, ease: 'power3.out',
        onComplete: () => { if (prev !== next) prev.classList.remove('is-active'); },
      });
      animateTo(50, .6);
      gsap.fromTo(current, { yPercent: dir * 60, opacity: 0 }, { yPercent: 0, opacity: 1, duration: .4, ease: 'power2.out' });
    };
    document.querySelector('[data-ba-prev]')?.addEventListener('click', () => go(-1));
    document.querySelector('[data-ba-next]')?.addEventListener('click', () => go(1));
  }
</script>
