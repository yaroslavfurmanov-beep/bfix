---
import Button from './Button.astro';
import article from '../icons/article.svg?raw';
import { articles } from '../data/content';
---
<section class="tips screen" id="blog">
  <div class="wrap" data-fit>
    <h2 class="t-h1" data-reveal><b class="w7">Tips</b> for Florida homes</h2>
    <ul class="tips__grid m-rail" aria-label="Articles, swipe for more">
      {articles.map((a) => (
        <li data-reveal>
          <a class="article" href="#blog">
            <span class="article__media">
              <img src={a.image} alt="" width="390" height="239" loading="lazy" />
            </span>
            <span class="t-label article__tag">{a.tag}</span>
            <span class="t-h3 article__title">{a.title}</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="tips__cta" data-reveal>
      <Button href="#blog" variant="orange"><Fragment set:html={article} />All articles</Button>
    </div>
  </div>
</section>

<style>
  .tips__grid {
    display: grid;
    grid-template-columns: repeat(3, 390px);
    column-gap: 15px;
    margin-top: 40px;
  }
  .article { display: flex; flex-direction: column; gap: 16px; }
  .article__media {
    display: block;
    overflow: hidden;
    clip-path: polygon(0 26px, 25.5px 0, 100% 0, 100% calc(100% - 27.5px), calc(100% - 33.2px) 100%, 0 100%);
  }
  .article__media img {
    width: 390px;
    height: 239px;
    object-fit: cover;
    transition: transform .8s var(--ease-out);
  }
  .article:hover img { transform: scale(1.04); }
  .article__tag { color: var(--n-600); }
  .article__title { max-width: 360px; margin-top: -8px; transition: color .2s; }
  .article:hover .article__title { color: var(--brand-orange); }
  .tips__cta { display: flex; justify-content: center; margin-top: 40px; }

  /* ---------- phones: articles are secondary content, so they go into a swipe rail ---------- */
  @media (max-width: 767px) {
    .tips__grid { margin-top: 28px; }
    .article__media img { width: 100%; height: auto; aspect-ratio: 390 / 239; }
    .article__title { max-width: none; }
    .tips__cta { margin-top: 28px; }
    .tips__cta :global(.btn) { width: 100%; max-width: 400px; }
  }
</style>
