---
/** 58×58 chamfered orange tile with an icon (UI-kit "Icon tile") */
interface Props { icon: string }
const { icon } = Astro.props;
---
<span class="tile" data-tile>
  <svg class="tile__shape" viewBox="0 0 58 58" width="58" height="58" aria-hidden="true">
    <polygon points="0,10.37 10.34,0 58,0 58,46.83 47.66,58 0,58" />
  </svg>
  <span class="tile__icon" set:html={icon} />
</span>

<style>
  .tile {
    position: relative;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    filter: drop-shadow(0 1.65px 11px rgba(222, 82, 34, .3));
  }
  .tile__shape { position: absolute; inset: 0; fill: var(--brand-orange); }
  .tile__icon { position: relative; display: grid; }
</style>
